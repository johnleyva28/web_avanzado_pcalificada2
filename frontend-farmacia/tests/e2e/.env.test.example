# Plantilla de variables de entorno para los tests E2E.
# Copiar como .env.test y rellenar con valores reales.
#   cp tests/e2e/.env.test.example tests/e2e/.env.test
# .env.test esta en .gitignore, NO commitear.

# URL del frontend (donde corre la UI)
FRONTEND_URL=https://web-avanzado-pcalificada2-1.onrender.com

# URL base del backend (sin path /api)
API_URL=https://web-avanzado-pcalificada2.onrender.com/api

# Cuenta de prueba con permisos de admin
# (puede ser admin@farmacia.com del seed, o la cuenta personal del dev)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

# Cuenta con permisos de moderador (opcional)
TEST_MOD_EMAIL=
TEST_MOD_PASSWORD=

# Cuenta con permisos de cliente (opcional)
TEST_CLIENT_EMAIL=
TEST_CLIENT_PASSWORD=
