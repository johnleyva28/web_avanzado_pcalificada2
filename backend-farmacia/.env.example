# =====================================================
# backend-farmacia — Variables de entorno (plantilla)
# =====================================================
# Copia este archivo como `.env` y rellena los valores reales.
# NUNCA commitees el archivo `.env` con credenciales reales.
# =====================================================

# Puerto del servidor Express
PORT=4000

# Entorno de ejecución: development | production
NODE_ENV=development

# Cadena de conexión a PostgreSQL (Supabase, Render, local, etc.)
# Formato típico postgres://USER:PASSWORD@HOST:PUERPORT/DBNAME
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Secreto para firmar los tokens JWT. Usa una cadena larga y aleatoria.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_valor_por_uno_aleatorio_y_largo

# Origen del frontend permitido por CORS (separar con coma si hay varios)
# Ejemplos:
#   FRONTEND_URL=http://localhost:3000
#   FRONTEND_URL=http://localhost:3000,https://mi-farmacia.vercel.app
FRONTEND_URL=http://localhost:3000

# Tiempo de expiración del token JWT (formato válido para jsonwebtoken)
JWT_EXPIRES_IN=8h